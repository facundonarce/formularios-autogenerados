{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/form.js": { "maxDuration": 60 },
    "api/admin.js": { "maxDuration": 60 },
    "api/cron.js": { "maxDuration": 60 },
    "api/upload.js": { "maxDuration": 30 },
    "api/setup.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
